# CAS Forex Revamp environment configuration (example only - never commit real secrets)
# Python site-packages location override used inside isolated air-gapped runtime containers
CAS_FOREX_PYTHON_SITE=/opt/cas-forex/python-site

# Systemd private state directory for Stage B confined role services
STATE_DIRECTORY=/var/lib/cas-fx-role

# Optional Node.js runtime flags & module lookup root for UI contract tooling
NODE_OPTIONS=
NODE_PATH=

# =====================================================================
# EXECUTION MODE: DEMO (default locked) vs LIVE (requires 2-key phrase)
# =====================================================================
# Leave DEMO (or unset) for paper/demo accounts ONLY.
# To enable LIVE real-money trading across MT5 + OANDA fxTrade, set BOTH:
#   CAS_FOREX_EXECUTION_MODE=LIVE
#   CAS_FOREX_LIVE_ARM_PHRASE=I_AUTHORIZE_LIVE_REAL_MONEY_TRADING
CAS_FOREX_EXECUTION_MODE=DEMO
CAS_FOREX_LIVE_ARM_PHRASE=

# =====================================================================
# MODE A: DEMO / PRACTICE CREDENTIALS (used when CAS_FOREX_EXECUTION_MODE=DEMO)
# =====================================================================
CAS_FOREX_OANDA_PRACTICE_TOKEN=
CAS_FOREX_OANDA_PRACTICE_ACCOUNT_ID=

# Primary broker: HUGOSWAY_MT5 (default), LHFX_MT5, or OANDA_PRACTICE / OANDA_LIVE
CAS_FOREX_PRIMARY_BROKER=HUGOSWAY_MT5
# MT5 transport: AUTO (default), NATIVE_PYTHON (Windows MetaTrader5 package), or SPOOL_BRIDGE (mt5/CasForexMt5Bridge.mq5)
CAS_FOREX_MT5_TRANSPORT_MODE=AUTO
CAS_FOREX_MT5_SPOOL_DIR=

# Hugo's Way MT5 (DEMO default server: Hugo demo PRO5 | LIVE server: Hugo PRO5)
CAS_FOREX_HUGOSWAY_MT5_LOGIN=
CAS_FOREX_HUGOSWAY_MT5_PASSWORD=
CAS_FOREX_HUGOSWAY_MT5_SERVER=Hugo demo PRO5

# LHFX MT5 (DEMO default server: LHFXSA-Demo | LIVE server: LHFXSA-Live)
CAS_FOREX_LHFX_MT5_LOGIN=
CAS_FOREX_LHFX_MT5_PASSWORD=
CAS_FOREX_LHFX_MT5_SERVER=LHFXSA-Demo

# =====================================================================
# MODE B: LIVE REAL-MONEY OANDA fxTrade (used ONLY when LIVE is two-key armed)
# =====================================================================
CAS_FOREX_OANDA_LIVE_TOKEN=
CAS_FOREX_OANDA_LIVE_ACCOUNT_ID=

# =====================================================================
# DUAL-SHIELD BARBELL RISK PARAMETERS (enforced identically in DEMO & LIVE)
# =====================================================================
CAS_FOREX_BARBELL_OANDA_RESERVE_SHARE=0.80
CAS_FOREX_BARBELL_HUGOSWAY_SHARE=0.12
CAS_FOREX_BARBELL_LHFX_SHARE=0.08
CAS_FOREX_BARBELL_MAX_STOP_RISK_PCT=1.00
CAS_FOREX_MAX_DRAWDOWN_PCT=0.10
