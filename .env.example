# CAS Forex Revamp environment configuration (example only - never commit real secrets)
# Python site-packages location override used inside isolated air-gapped runtime containers
CAS_FOREX_PYTHON_SITE=/opt/cas-forex/python-site

# Systemd private state directory for Stage B confined role services
STATE_DIRECTORY=/var/lib/cas-fx-role

# Optional Node.js runtime flags & module lookup root for UI contract tooling
NODE_OPTIONS=
NODE_PATH=

# =====================================================================
# EXECUTION MODE: DEMO (default locked) vs LIVE (requires 2-key phrase)
# =====================================================================
# Leave DEMO (or unset) for paper/demo accounts ONLY.
# To enable LIVE real-money trading across MT5 + OANDA fxTrade, set BOTH:
#   CAS_FOREX_EXECUTION_MODE=LIVE
#   CAS_FOREX_LIVE_ARM_PHRASE=I_AUTHORIZE_LIVE_REAL_MONEY_TRADING
CAS_FOREX_EXECUTION_MODE=DEMO
CAS_FOREX_LIVE_ARM_PHRASE=

# =====================================================================
# MODE A: DEMO / PRACTICE CREDENTIALS (used when CAS_FOREX_EXECUTION_MODE=DEMO)
# =====================================================================
CAS_FOREX_OANDA_PRACTICE_TOKEN=
CAS_FOREX_OANDA_PRACTICE_ACCOUNT_ID=

# Primary broker: HUGOSWAY_MT5 (default), LHFX_MT5, or OANDA_PRACTICE / OANDA_LIVE
CAS_FOREX_PRIMARY_BROKER=HUGOSWAY_MT5
# MT5 transport: AUTO (default), NATIVE_PYTHON (Windows MetaTrader5 package), or SPOOL_BRIDGE (mt5/CasForexMt5Bridge.mq5)
CAS_FOREX_MT5_TRANSPORT_MODE=AUTO
CAS_FOREX_MT5_SPOOL_DIR=

# Hugo's Way MT5 (DEMO server: Hugosway-Demo or Hugo demo PRO5 | LIVE server: Hugo PRO5 or Hugosway-Live)
CAS_FOREX_HUGOSWAY_MT5_LOGIN=
CAS_FOREX_HUGOSWAY_MT5_PASSWORD=
CAS_FOREX_HUGOSWAY_MT5_SERVER=Hugosway-Demo

# LHFX MT5 (Unified DEMO/LIVE server: LHFXSA-Trade, or LHFXSA-Demo / LHFXSA-Live; gated by ACCOUNT_TRADE_MODE)
CAS_FOREX_LHFX_MT5_LOGIN=
CAS_FOREX_LHFX_MT5_PASSWORD=
CAS_FOREX_LHFX_MT5_SERVER=LHFXSA-Trade

# =====================================================================
# MODE B: LIVE REAL-MONEY OANDA fxTrade (used ONLY when LIVE is two-key armed)
# =====================================================================
CAS_FOREX_OANDA_LIVE_TOKEN=
CAS_FOREX_OANDA_LIVE_ACCOUNT_ID=

# =====================================================================
# DUAL-SHIELD BARBELL RISK PARAMETERS (enforced identically in DEMO & LIVE)
# =====================================================================
CAS_FOREX_BARBELL_OANDA_RESERVE_SHARE=0.80
CAS_FOREX_BARBELL_HUGOSWAY_SHARE=0.12
CAS_FOREX_BARBELL_LHFX_SHARE=0.08
CAS_FOREX_BARBELL_MAX_STOP_RISK_PCT=1.00
CAS_FOREX_MAX_DRAWDOWN_PCT=0.10

# =====================================================================
# PORTABLE D:\MetaTrader5 SPOOL & US INDEX LEVERAGE (NAS100 / US30)
# =====================================================================
# On Windows, D:\MetaTrader5\cas_forex_spool is auto-discovered when left blank below.
# Set explicitly to override location:
CAS_FOREX_MT5_SPOOL_DIR=
CAS_FOREX_INDEX_LEVERAGE=200

# =====================================================================
# AUTONOMOUS AI MODEL SELECTOR (FRONTIER #1-#8 STRICTLY AHEAD OF QWEN #9)
# =====================================================================
# Ordered choices (pick any frontier ID; qwen3:0.6b is offline air-gapped fallback ONLY):
#   1. claude-fable-5.2     (Anthropic flagship)
#   2. claude-fable         (Anthropic strategist)
#   3. claude-5.5           (Anthropic analyst)
#   4. gemini-decision-1    (Google Decisions API 150-250ms NAS100/US30 burst scalper)
#   5. gemini-carbon        (Google Gemini)
#   6. gemini-argon         (Google Gemini)
#   7. openai-astra         (OpenAI)
#   8. deepseek-flash-1017  (DeepSeek)
#   9. qwen3:0.6b           (Local Ollama v0.40.2 offline fallback ONLY)
CAS_FOREX_AI_MODEL=claude-fable-5.2
CAS_FOREX_GEMINI_DECISION_SCOUT=true
CAS_FOREX_DECISION_MIN_PROBABILITY=0.60
CAS_FOREX_OLLAMA_FALLBACK_ENABLED=false

# Provider API keys (populate whichever frontier provider(s) you use):
CAS_FOREX_ANTHROPIC_API_KEY=
CAS_FOREX_GEMINI_API_KEY=
CAS_FOREX_OPENAI_API_KEY=
CAS_FOREX_DEEPSEEK_API_KEY=

# Optional provider model-slug overrides:
CAS_FOREX_ANTHROPIC_FABLE_5_2_MODEL_ID=claude-fable-5-2
CAS_FOREX_ANTHROPIC_FABLE_MODEL_ID=claude-fable
CAS_FOREX_ANTHROPIC_5_5_MODEL_ID=claude-opus-5-5
CAS_FOREX_GEMINI_DECISION_1_MODEL_ID=gemini-decision-1
CAS_FOREX_GEMINI_CARBON_MODEL_ID=gemini-4-carbon
CAS_FOREX_GEMINI_ARGON_MODEL_ID=gemini-4-argon
CAS_FOREX_OPENAI_ASTRA_MODEL_ID=openai-astra
CAS_FOREX_DEEPSEEK_FLASH_MODEL_ID=deepseek-flash-1017

# =====================================================================
# DAILY PROFIT QUOTA LOCK ($500-$1,000) & LOSS CIRCUIT BREAKER
# =====================================================================
CAS_FOREX_DAILY_SOFT_QUOTA_USD=500.00
CAS_FOREX_DAILY_HARD_QUOTA_USD=1000.00
# Optional % compounding quota for smaller starter accounts (e.g. 0.025 = +2.50%/day):
CAS_FOREX_DAILY_QUOTA_PCT=
CAS_FOREX_DAILY_QUOTA_MODE=USD
CAS_FOREX_DAILY_MAX_LOSS_USD=500.00
CAS_FOREX_DAILY_MAX_LOSS_PCT=0.03
CAS_FOREX_MAX_CONSECUTIVE_LOSSES=3
# CAS_FOREX_OLLAMA_FALLBACK_MODEL_ID=qwen3:0.6b
# CAS_FOREX_OANDA_ALLOW_INDEX_CFD=0

# =====================================================================
# CRYPTOGRAPHIC LIVE AUTH, DURABLE STATE & 2-SPEED THINKING DEPTH
# =====================================================================
CAS_FOREX_LIVE_AUTH_KEY_FILE=
CAS_FOREX_LIVE_AUTH_TICKET_FILE=
CAS_FOREX_STATE_DIR=
CAS_FOREX_MODEL_MAX_CALLS_PER_DAY=5000
CAS_FOREX_MODEL_MAX_DAILY_SPEND_USD=25.00
CAS_FOREX_THINKING_DEPTH=AUTO

# =====================================================================
# 50%/50% PROFIT-SWEEP BANK VAULT & COINBASE / KRAKEN ACH OFFRAMPS
# =====================================================================
CAS_FOREX_PROFIT_SWEEP_RATIO=0.50
CAS_FOREX_PROFIT_SWEEP_AUTO_ENABLED=true
CAS_FOREX_PROFIT_SWEEP_PREFERRED_RAIL=BROKER_2FA_MANUAL

# Coinbase Advanced Trade CDP ES256 (owner linked ACH bank ID ONLY)
CAS_FOREX_COINBASE_KEY_NAME=
CAS_FOREX_COINBASE_PRIVATE_KEY_FILE=
CAS_FOREX_COINBASE_BANK_ACCOUNT_ID=

# Kraken Pro HMAC-SHA512 (owner linked ZUSD ACH bank key ONLY)
CAS_FOREX_KRAKEN_API_KEY=
CAS_FOREX_KRAKEN_API_SECRET=
CAS_FOREX_KRAKEN_BANK_ACCOUNT_ID=

# =====================================================================
# OPTIONAL CLOUD FIREBASE MIRRORING (STRICTLY DISABLED BY DEFAULT)
# =====================================================================
CAS_FOREX_FIREBASE_SYNC_ENABLED=false
