# CAS Forex Revamp environment configuration (example only - never commit real secrets)
# Python site-packages location override used inside isolated air-gapped runtime containers
CAS_FOREX_PYTHON_SITE=/opt/cas-forex/python-site

# Systemd private state directory for Stage B confined role services
STATE_DIRECTORY=/var/lib/cas-fx-role

# Optional Node.js runtime flags & module lookup root for UI contract tooling
NODE_OPTIONS=
NODE_PATH=

# Optional OANDA v20 practice-only paper account credentials (live fxtrade hosts are forbidden in code)
CAS_FOREX_OANDA_PRACTICE_TOKEN=
CAS_FOREX_OANDA_PRACTICE_ACCOUNT_ID=

# Phase 6 MetaTrader 5 dual-shield broker routing (DEMO / PRACTICE ACCOUNTS ONLY - live servers are refused in code)
# Primary broker: HUGOSWAY_MT5 (default), LHFX_MT5, or OANDA_PRACTICE (conservative: every trade to the regulated safe harbor)
CAS_FOREX_PRIMARY_BROKER=
# MT5 transport: AUTO (default), NATIVE_PYTHON (official MetaTrader5 package on Windows), or SPOOL_BRIDGE (mt5/CasForexMt5Bridge.mq5)
CAS_FOREX_MT5_TRANSPORT_MODE=
# Spool root shared with the EA, e.g. <Terminal>/Common/Files/cas_forex_spool (per-broker subfolders hugosway_mt5 / lhfx_mt5)
CAS_FOREX_MT5_SPOOL_DIR=

# Hugo's Way MetaTrader 5 demo (primary main; server defaults to the Hugo demo PRO5 demo server, 1:500)
CAS_FOREX_HUGOSWAY_MT5_LOGIN=
CAS_FOREX_HUGOSWAY_MT5_PASSWORD=
CAS_FOREX_HUGOSWAY_MT5_SERVER=

# LHFX MetaTrader 5 demo (secondary; server defaults to the LHFXSA-Demo demo server, 1:500)
CAS_FOREX_LHFX_MT5_LOGIN=
CAS_FOREX_LHFX_MT5_PASSWORD=
CAS_FOREX_LHFX_MT5_SERVER=

# Dual-shield barbell shares (must sum to 1; defaults 0.80 / 0.12 / 0.08) and stop-loss equity risk cap in percent (default 1.00)
CAS_FOREX_BARBELL_OANDA_RESERVE_SHARE=
CAS_FOREX_BARBELL_HUGOSWAY_SHARE=
CAS_FOREX_BARBELL_LHFX_SHARE=
CAS_FOREX_BARBELL_MAX_STOP_RISK_PCT=
