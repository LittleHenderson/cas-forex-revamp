        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "symbol",
            "detail"
          ],
          "properties": {
            "observed_at": {
              "$ref": "#/$defs/timestamp"
            },
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "symbol": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/symbol"
                }
              ]
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          }
