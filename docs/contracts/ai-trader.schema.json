      ],
      "properties": {
        "schema": {
          "const": "cas-forex.banked-session/1"
        },
        "accounting_basis": {
          "const": "INTERNAL_LEDGER_NOT_CONFIRMED_PAYOUT"
        },
        "session_date": {
          "$ref": "#/$defs/sessionIdentifier"
        },
        "initial_capital_usd": {
          "$ref": "#/$defs/decimal"
        },
        "current_total_equity_usd": {
          "$ref": "#/$defs/decimal"
        },
        "net_surplus_usd": {
          "$ref": "#/$defs/decimal"
        },
        "net_surplus_pct": {
          "$ref": "#/$defs/decimal"
        },
        "deficit_to_principal_usd": {
          "$ref": "#/$defs/decimal"
        },
        "capital_status": {
          "enum": [
            "RECOVERY_MODE",
            "AT_PRINCIPAL",
            "IN_SURPLUS"
          ]
        },
        "vault_sweeps_paused_for_recovery": {
          "type": "boolean"
        },
        "session_cadence": {
          "enum": [
            "AUTO",
            "DAILY_NY",
            "REGIONAL_RECOVERY",
            "REGIONAL_8H"
          ]
        },
        "active_region_window": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "active_session_leg": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "can_advance_recovery_session": {
          "type": "boolean"
        },
        "banked_net_pnl_usd": {
          "$ref": "#/$defs/decimal"
        },
        "realized_pnl_pct": {
          "$ref": "#/$defs/decimal"
        },
        "peak_realized_pnl_usd": {
          "$ref": "#/$defs/decimal"
        },
        "protected_profit_floor_usd": {
          "$ref": "#/$defs/decimal"
        },
        "ratchet_armed": {
          "type": "boolean"
        },
        "closed_trades": {
          "$ref": "#/$defs/nonNegativeInt"
        },
        "win_count": {
          "$ref": "#/$defs/nonNegativeInt"
        },
        "loss_count": {
          "$ref": "#/$defs/nonNegativeInt"
        },
        "vault_total_realized_usd": {
          "$ref": "#/$defs/decimal"
        },
        "vault_swept_50pct_usd": {
          "$ref": "#/$defs/decimal"
        },
        "session_vault_reserved_50pct_usd": {
          "$ref": "#/$defs/decimal"
        },
        "vault_retained_50pct_usd": {
          "$ref": "#/$defs/decimal"
        },
        "confirmed_bank_payouts_usd": {
          "$ref": "#/$defs/decimal"
        },
        "pending_unconfirmed_transfers_usd": {
          "$ref": "#/$defs/decimal"
        },
        "profits_locked_for_session": {
          "type": "boolean"
        },
        "operating_mode": {
          "enum": [
