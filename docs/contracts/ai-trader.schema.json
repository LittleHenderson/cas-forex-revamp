      ]
    },
    "marketSessionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "window_utc",
        "open"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "window_utc": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "open": {
          "type": "boolean"
        }
      }
    },
    "marketSessions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utc_time",
        "forex_24_5_open",
        "forex_label",
        "us_indices_status",
        "us_indices_label",
        "mt5_tick_fresh",
        "sessions"
      ],
      "properties": {
        "utc_time": {
          "type": "string",
          "minLength": 9,
          "maxLength": 16,
          "pattern": "^\\d{2}:\\d{2} UTC$"
        },
        "forex_24_5_open": {
          "type": "boolean"
        },
        "forex_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "us_indices_status": {
          "enum": [
            "WEEKEND_CLOSED",
            "DAILY_BREAK",
            "CASH_OPEN",
            "EXTENDED_OPEN"
          ]
        },
        "us_indices_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "mt5_tick_fresh": {
          "type": "boolean"
        },
        "sessions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/marketSessionEntry"
          }
        }
      }
    },
    "sessionIdentifier": {
      "type": "string",
      "minLength": 10,
      "maxLength": 48,
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(?:-[A-Z_]+)?(?:#leg[0-9]+)?$"
    },
    "bankedSession": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "accounting_basis",
        "session_date",
        "initial_capital_usd",
        "current_total_equity_usd",
        "net_surplus_usd",
        "net_surplus_pct",
        "deficit_to_principal_usd",
        "capital_status",
        "vault_sweeps_paused_for_recovery",
