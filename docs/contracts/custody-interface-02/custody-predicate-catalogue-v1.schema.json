        },
        "positive_partial_remainder": {
          "minLength": 1,
          "type": "string"
        },
        "prior_A_observed": {
          "minLength": 1,
          "type": "string"
        },
        "protection_modified": {
          "minLength": 1,
          "type": "string"
        },
        "relevant_change_observed": {
          "minLength": 1,
          "type": "string"
        },
        "same_position_quantity": {
          "minLength": 1,
          "type": "string"
        },
        "same_position_stop_quantity": {
