        "stale_rejected",
        "stand_down",
        "valid_bounded_action_observed",
        "valid_position_held"
      ],
      "type": "object"
    },
    "common_every_step": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array"
    },
    "format": {
      "const": "forex.custody-predicates/1"
    },
    "global_acceptance": {
      "additionalProperties": false,
      "properties": {
        "application_or_model_execution_status": {
          "const": "NOT_RUN"
        },
        "missing_rows_policy": {
          "const": "INCOMPLETE"
        },
        "required_independent_review": {
          "const": true
        },
        "rule": {
          "minLength": 1,
          "type": "string"
        },
        "unknown_predicate_policy": {
          "const": "BLOCK"
        }
      },
      "required": [
        "rule",
        "required_independent_review",
        "unknown_predicate_policy",
        "missing_rows_policy",
        "application_or_model_execution_status"
      ],
      "type": "object"
    },
    "interpretation": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "format",
    "interpretation",
    "common_every_step",
    "assertions",
    "global_acceptance"
  ],
  "type": "object"
