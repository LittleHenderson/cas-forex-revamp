  "additionalProperties": false,
  "properties": {
    "assertions": {
      "additionalProperties": false,
      "properties": {
        "actual_entry": {
          "minLength": 1,
          "type": "string"
        },
        "bounded_authority": {
          "minLength": 1,
          "type": "string"
        },
        "changed_context_observed": {
          "minLength": 1,
          "type": "string"
        },
        "choice_A": {
          "minLength": 1,
          "type": "string"
        },
        "choice_B": {
          "minLength": 1,
          "type": "string"
        },
        "different_downstream_effect": {
          "minLength": 1,
          "type": "string"
        },
        "entry_observed": {
          "minLength": 1,
          "type": "string"
        },
        "expansion_rejected": {
          "minLength": 1,
          "type": "string"
        },
        "explicit_wait": {
          "minLength": 1,
          "type": "string"
        },
        "fresh_inference": {
          "minLength": 1,
          "type": "string"
        },
        "full_exit": {
          "minLength": 1,
          "type": "string"
        },
        "missing_fact_preserved": {
          "minLength": 1,
          "type": "string"
        },
        "no_dispatch_or_venue_change": {
          "minLength": 1,
          "type": "string"
        },
        "no_new_risk": {
          "minLength": 1,
          "type": "string"
        },
        "none_eligible": {
