    "auto_shift_enabled": {
      "type": "boolean"
    },
    "master": {
      "$ref": "#/$defs/masterDetail"
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/tierDialItem"
      }
    },
    "tiers_by_id": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "TIER_1_CURRENT": {
          "$ref": "#/$defs/tierDialItem"
        },
        "TIER_2_1000": {
          "$ref": "#/$defs/tierDialItem"
        },
        "TIER_3_3000": {
          "$ref": "#/$defs/tierDialItem"
