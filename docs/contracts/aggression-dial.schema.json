{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cas-forex:aggression-dial:1.0",
  "title": "AggressionDialSnapshot",
  "description": "Master Trading Aggression Dial (20..100 bps) & Section B.5 5-Tier Controls snapshot for GET/POST /api/aggression-dial.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scope_id",
    "min_risk_bps",
    "max_risk_bps",
    "high_risk_min_bps",
    "owner_controls_allowed",
    "access_mode",
    "master_risk_bps",
    "master_risk_pct",
    "effective_risk_bps",
    "effective_risk_pct",
    "effective_label",
    "css_class",
    "ai_discretion_enabled",
    "ai_discretion_ceiling_bps",
    "ai_discretion_reason",
    "auto_shift_enabled",
    "master",
    "tiers",
    "tiers_by_id",
    "anchor_knots",
    "bps_catalog",
    "guardrails",
    "audit_count",
    "audit_head_sha256"
  ],
  "properties": {
    "schema": {
      "const": "cas-forex.aggression-dial/1"
    },
    "scope_id": {
      "$ref": "#/$defs/identifier"
    },
    "min_risk_bps": {
      "const": 20
    },
    "max_risk_bps": {
      "const": 100
    },
    "high_risk_min_bps": {
      "const": 80
    },
    "owner_controls_allowed": {
      "type": "boolean"
    },
    "access_mode": {
      "enum": [
        "OWNER_FULL_CONTROL",
        "DEVICE_READ_AND_EXPLAINER"
      ]
    },
    "live_mode": {
      "type": "boolean"
    },
    "execution_mode": {
      "enum": [
        "DEMO",
        "LIVE"
      ]
    },
    "connected": {
      "type": "boolean"
    },
    "audit_verified": {
      "type": "boolean"
    },
    "master_risk_bps": {
      "$ref": "#/$defs/riskBps"
    },
    "master_risk_pct": {
      "$ref": "#/$defs/decimal"
    },
    "effective_risk_bps": {
      "$ref": "#/$defs/riskBps"
    },
    "effective_risk_pct": {
      "$ref": "#/$defs/decimal"
    },
    "effective_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
